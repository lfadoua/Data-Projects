# Copy to .env and keep real values out of Git.
APP_ENV=development
STREAMLIT_API_URL=http://127.0.0.1:8000
# Local Python / Supabase connection. DB_SCHEMA isolates this app's tables.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_market
DB_USER=job_market
DB_PASSWORD=
DB_SSLMODE=prefer
DB_SCHEMA=djmi
# Docker database settings; choose a strong local password.
POSTGRES_DB=job_market
POSTGRES_USER=job_market
POSTGRES_PASSWORD=
# V1 LSA is retained for rollback. V2 BGE is built with indexing --v2.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=128
EMBEDDING_BATCH_SIZE=64
# extractive | openai | ollama
LLM_PROVIDER=extractive
OPENAI_API_KEY=
LLM_MODEL=
OLLAMA_URL=http://localhost:11434
RAG_RETRIEVAL_K=20
RAG_RERANK_K=8
RAG_CONTEXT_K=6
RAG_SIMILARITY_THRESHOLD=0.15
RAG_RERANKER=cross_encoder
RAG_DEBUG=false
CHUNK_SIZE=450
CHUNK_OVERLAP=60
V2_CHUNK_SIZE=320
V2_CHUNK_OVERLAP=40
PROMPT_VERSION=v2
# Empty disables HTTP reindexing. CLI indexing remains available.
ADMIN_TOKEN=
# Optional explicit prices for evaluation; blank means cost is unavailable.
INPUT_COST_PER_MILLION=
OUTPUT_COST_PER_MILLION=
