# Repository text policy; existing secret files are never normalized.
*.py text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.sql text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.env -text
.env.* -text
.env.example text eol=lf
*.png binary
*.jpg binary

*.pdf binary
